      non_none_args = [arg for arg in args if arg is not type(None)]\n    91\t                if non_none_args:\n    92\t                    base_type = non_none_args[0]\n    93\t\n    94\t            field_wrapper_types[field_name] = base_type\n    95\t\n    96\t        for key, value in fields.items():\n    97\t            # Skip flattened credential fields (e.g., \"api_credential.token\")\n    98\t            if \".\" in key:\n    99\t                continue\n   100\t\n   101\t            # Check if this field belongs to OutputFields (previous run data)\n   102\t            if key in output_field_names:\n   103\t                previous_output_data[key] = value\n   104\t                continue\n   105\t\n   106\t            # Skip None values\n   107\t            if value is None:\n   108\t                processed[key] = value\n   109\t                continue\n   110\t\n   111\t            # Get the wrapper type for this field\n   112\t            wrapper_type = field_wrapper_types.get(key)\n   113\t\n   114\t            # Convert to appropriate wrapper type\n   115\t            if wrapper_type == SingleChoice:\n   116\t                # UAC sends as list, SingleChoice expects list\n   117\t                if isinstance(value, list):\n   118\t                    value = SingleChoice(_values=value)\n   119\t                else:\n   120\t                    value = SingleChoice(_values=[value])\n   121\t\n   122\t            elif wrapper_type == MultiChoice:\n   123\t                # UAC sends as list, MultiChoice expects list\n   124\t                if isinstance(value, list):\n   125\t                    value = MultiChoice(values=value)\n   126\t                else:\n   127\t                    value = MultiChoice(values=[value])\n   128\t\n   129\t            elif wrapper_type == Script:\n   130\t                # UAC sends as string path, Script expects Path object\n   131\t                if isinstance(value, str):\n   132\t                    value =