    "file_path": "/tmp/iss-ue-ca-cache-1002/ca2d9875d9e1c0bdf814f992f0708fb26bc6e19fd1ca872fbde272fbb4478517/claude/uac/ue-ca/skills/retrieving-context/references/implementation_docs/input_fields.md"
