     issues.append(f\"Field '{f['name']}' has showIfField but noSpaceIfHidden is False\")\n\n# Check output-only fields\noutput_fields = [f for f in fields if f.get(\"fieldRestriction\") == \"Output Only\"]\nprint(f\"Output fields: {[f['name'] for f in output_fields]}\")\n\n# Print field summary\nprint(\"\\nField summary:\")\nfor f in fields:\n    print(f\"  seq={f['sequence']} name={f['name']} mapping={f['fieldMapping']} type={f['fieldType']} required={f['required']} extstatus={f.get('extensionStatus',False)}\")\n\n# Check sysIds preserved for known fields\nif fields[0][\"sysId\"] != \"d0c6e999d5a5426ea365afd4de31ba49\":\n    issues.append(\"action field sysId changed!\")\nif fields[0][\"choices\"][0][\"sysId\"] != \"0ba99c69f4744d1fbd28f8ee52f5a71b\":\n    issues.append(\"action choice[0] sysId changed!\")\nif fields[0][\"choices\"][1][\"sysId\"] != \"76df91aecc354f93b8a24e4d16019e7b\":\n    issues.append(\"action choice[1] sysId changed!\")\nif tmpl[\"sysId\"] != \"0adb203bbc7a4426b07497e919ead5bf\":\n    issues.append(\"Template sysId changed!\")\n\nif issues:\n    print(\"\\nISSUES FOUND:\")\n    for i in issues:\n        print(f\"  - {i}\")\nelse:\n    print(\"\\nAll checks passed.\")\nEOF\n","description":"Run automated checks on template.json structure and constraints"},"tool_use_id":"toolu_01PjAFFoDzwatyxj4oUTUoGL"}

